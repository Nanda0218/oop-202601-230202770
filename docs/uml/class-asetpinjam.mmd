    Aset <|-- Ruang
    Aset <|-- Laptop
    Aset <|-- AlatLab
    DapatDipinjam <|.. Aset
    AturanDenda <|.. DendaFlat
    AturanDenda <|.. DendaProgresif
    Aset "1" --> "1" StatusAset : status
    Aset "1" --> "1" Kondisi : kondisi
    Aset ..> JenisAset : mengembalikan
    AlatLab "1" --> "1" TingkatRisiko : risiko
    Peminjaman "*" --> "1" Peminjam : peminjam
    Peminjaman "*" --> "1" Aset : aset
    Peminjaman "1" --> "1" StatusPeminjaman : status
    JadwalPeminjaman "1" o-- "0..*" Peminjaman : jadwal
    KatalogAset "1" o-- "0..*" Aset : katalog
    LayananDenda --> AturanDenda : aturan
    DendaFlat ..> Aset : hitung
    DendaProgresif ..> Aset : hitung
    AsetDAO ..> Aset : akses data
    PeminjamanDAO ..> Peminjaman : akses data
